  /* ==========================================================================
   DARK MODE SUPPORT (body.dark)
   ========================================================================== */

  body.dark .search-content {
    --background: #121212 !important;
  }

  body.dark .search-header,
  body.dark .filters-panel,
  body.dark .results-header,
  body.dark .search-footer,
  body.dark ion-segment {
    background: #1e1e1e !important;
    border-color: rgba(255, 255, 255, 0.1) !important;
  }

  body.dark .suggestions-dropdown,
  body.dark .recommendation-card {
    background: #1e1e1e !important;
    border-color: rgba(255, 255, 255, 0.1) !important;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4) !important;
  }

  body.dark .product-card {
    background: #1e1e1e !important;
    border-color: rgba(255, 255, 255, 0.1) !important;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3) !important;
  }

  body.dark .product-image-container {
    background: #252525 !important;
  }

  body.dark .product-name1,
  body.dark .product-price,
  body.dark .results-count,
  body.dark .filters-header h3 {
    color: #ffffff !important;
  }

  body.dark .product-description1,
  body.dark .quick-label,
  body.dark .loading-center p {
    color: #b0b0b0 !important;
  }

  body.dark .price-input {
    background: #2a2a2a !important;
    border-color: rgba(255, 255, 255, 0.1) !important;
    color: #ffffff !important;
  }

  body.dark .price-input:focus {
    border-color: var(--ion-color-primary) !important;
  }

  body.dark .history-chip,
  body.dark .quick-search-chip {
    --background: #2a2a2a !important;
    --color: #ffffff !important;
  }

  body.dark .spell-check-banner {
    background: rgba(255, 193, 7, 0.1) !important;
    border-left-color: var(--ion-color-warning) !important;
    color: #ffc107 !important;
  }

  body.dark ion-searchbar {
    --background: #2a2a2a !important;
    --color: #ffffff !important;
    --placeholder-color: #888 !important;
  }

  body.dark ion-segment-button {
    --color: #b0b0b0 !important;
    --color-checked: #ffffff !important;
  }

  body.dark .empty-state ion-icon {
    color: #555 !important;
  }

  body.dark .empty-state h3,
  body.dark .empty-state p {
    color: #888 !important;
  }

  body.dark ion-item {
    --background: transparent !important;
    --color: #ffffff !important;
  }

  body.dark ion-label {
    color: #ffffff !important;
  }

  body.dark ion-note {
    color: #b0b0b0 !important;
  }

  body.dark .filters-footer {
    border-top-color: rgba(255, 255, 255, 0.1) !important;
  }

  body.dark .corrected-query {
    color: var(--ion-color-primary-tint) !important;
  }

  /* Additional Dark Mode Overrides for Ionic Components */
  body.dark ion-range {
    --bar-background: #2a2a2a !important;
    --bar-background-active: var(--ion-color-primary) !important;
    --knob-background: var(--ion-color-primary) !important;
  }

  body.dark ion-checkbox {
    --background: #2a2a2a !important;
    --background-checked: var(--ion-color-primary) !important;
    --border-color: rgba(255, 255, 255, 0.2) !important;
    --border-color-checked: var(--ion-color-primary) !important;
    --checkmark-color: #ffffff !important;
  }

  body.dark ion-select {
    --background: #2a2a2a !important;
    --color: #ffffff !important;
    --placeholder-color: #888 !important;
  }

  body.dark ion-accordion-group {
    background: transparent !important;
  }

  body.dark ion-accordion {
    --background: #1e1e1e !important;
    --color: #ffffff !important;
  }

  body.dark ion-accordion ion-item {
    --background: #1e1e1e !important;
    --color: #ffffff !important;
    --border-color: rgba(255, 255, 255, 0.1) !important;
  }

  body.dark .search-tabs {
    background: #1e1e1e !important;
  }

  body.dark ion-card-content {
    background: transparent !important;
  }

  body.dark ion-text {
    color: #b0b0b0 !important;
  }

  body.dark ion-text h3,
  body.dark ion-text h4 {
    color: #ffffff !important;
  }

  body.dark ion-badge {
    --background: #2a2a2a !important;
    --color: #ffffff !important;
  }

  body.dark ion-thumbnail {
    background: #252525 !important;
  }

  body.dark .price-input-group label {
    color: #b0b0b0 !important;
  }

  body.dark .results-info {
    color: #b0b0b0 !important;
  }

  /* Dark Mode for Filter Option Buttons and Section Titles */
  body.dark .filter-actions ion-button {
    --color: #ffffff !important;
  }

  body.dark .quick-options ion-button {
    --background: #2a2a2a !important;
    --background-hover: #333 !important;
    --background-activated: #3a3a3a !important;
    --color: #ffffff !important;
    --border-color: rgba(255, 255, 255, 0.2) !important;
  }

  body.dark .sort-option-button {
    --background: #2a2a2a !important;
    --background-hover: #333 !important;
    --color: #ffffff !important;
    --border-color: rgba(255, 255, 255, 0.2) !important;
  }

  body.dark ion-button[fill="outline"] {
    --border-color: rgba(255, 255, 255, 0.3) !important;
    --color: #ffffff !important;
  }

  body.dark ion-button[fill="solid"] {
    --background: var(--ion-color-primary) !important;
    --color: #ffffff !important;
  }

  body.dark .section-title,
  body.dark .section-header h3,
  body.dark .section-header h2 {
    color: #ffffff !important;
  }

  body.dark ion-list-header {
    color: #ffffff !important;
  }

  body.dark ion-list-header ion-label {
    color: #ffffff !important;
  }

  body.dark .suggestion-item {
    --background: #1e1e1e !important;
    --background-hover: #2a2a2a !important;
    --border-color: rgba(255, 255, 255, 0.05) !important;
  }

  body.dark .suggestion-item h3 {
    color: #ffffff !important;
  }

  body.dark ion-accordion[slot="content"] {
    background: #1a1a1a !important;
  }

  body.dark .filters-panel ion-button {
    --color: #ffffff !important;
  }

  body.dark .search-button,
  body.dark .voice-button,
  body.dark .filter-button {
    --color: #ffffff !important;
  }